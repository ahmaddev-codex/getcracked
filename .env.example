# ─── Local development ────────────────────────────────────────────────────────
# Start the services first: pnpm services:up
# Ports are offset from the defaults so this stack coexists with other projects.

DATABASE_URL="postgresql://getcracked:getcracked@localhost:5433/getcracked"

# Upstash-compatible Redis, served locally by serverless-redis-http.
# Not yet used by any code — arrives with the L9 assistant rate limits.
UPSTASH_REDIS_REST_URL="http://localhost:8080"
UPSTASH_REDIS_REST_TOKEN="getcracked_local_token"

# ─── Production ───────────────────────────────────────────────────────────────
# DATABASE_URL       Neon pooled connection string (console.neon.tech)
# UPSTASH_REDIS_*    Upstash console (console.upstash.com)

# Better Auth. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-insecure-secret-change-me"
BETTER_AUTH_URL="http://localhost:3000"

# ─── Social sign-in (optional) ────────────────────────────────────────────────
# Both halves of a pair must be set, or that provider is not offered at all —
# a button with an empty client id fails only after the redirect, which reads
# as the product being broken. Leaving these blank keeps email and password.
#
# Google    console.cloud.google.com → APIs & Services → Credentials
#           Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# GitHub    github.com/settings/developers → New OAuth App
#           Authorisation callback URL: <BETTER_AUTH_URL>/api/auth/callback/github

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
